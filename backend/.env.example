PORT=3000
NODE_ENV=development

# Use a disposable local/test database. The seed command deletes app collections.
MONGO_URI=mongodb://127.0.0.1:27017/bookleaf_portal_dev

# Replace both values with independent, strong random secrets.
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
REFRESH_TOKEN_EXPIRES_DAYS=7

# Obtain a key from Groq. Never expose it in frontend/VITE_* variables.
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_CLASSIFY_MODEL=llama-3.1-8b-instant
GROQ_DRAFT_MODEL=llama-3.3-70b-versatile

# Must match the browser origin used by the frontend.
CLIENT_URL=http://localhost:5173
